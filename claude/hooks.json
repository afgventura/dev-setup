{
  "Stop":         [{ "hooks": [{ "type": "command", "command": "f=~/.config/tmux/agent-notify.sh; [ -x \"$f\" ] && exec \"$f\"; exit 0" }] }],
  "Notification": [{ "hooks": [{ "type": "command", "command": "f=~/.config/tmux/agent-notify.sh; [ -x \"$f\" ] && exec \"$f\"; exit 0" }] }],
