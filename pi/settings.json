{
  "packages": [
    "npm:cc-my-pi",
    "npm:pi-mcp-adapter@^5.0.0",
    "npm:pi-context-view",
    "npm:@juicesharp/rpiv-ask-user-question"
  ],
  "theme": "light",
  "defaultProvider": "byteplus",
  "defaultModel": "deepseek-v4-1-flash-260910",
  "hideThinkingBlock": true,
  "quietExtensionWarnings": true,
  "quietStartup": true,
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "byteplus/deepseek-v4-1-flash-260910": "medium",
    "openai-codex/gpt-6-luna": "medium",
    "opencode-go/deepseek-v4.1-flash": "high"
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 60000
  },
  "defaultProjectTrust": "always",
  "enabledModels": [
    "opencode-go/deepseek-v4.1-flash",
    "self-hosted/z-ai/glm-5.3-flash",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol",
    "byteplus/deepseek-v4-1-flash-260910"
  ],
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenScrollbar": "hidden",
  "fullscreenWheelScrollLines": 5,
  "extensions": [
    "-builtin:mcp"
  ]
}
