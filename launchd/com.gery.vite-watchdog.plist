<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gery.vite-watchdog</string>
  <!-- The script itself, not /bin/bash: macOS names the login item after the
       executable it launches, and `[/bin/bash, script]` showed up there as
       "bash" with no way to tell which job it was. -->
  <key>ProgramArguments</key>
  <array>
    <string>HOME_PLACEHOLDER/.config/tmux/vite-watchdog.sh</string>
  </array>
  <key>StartInterval</key><integer>5</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
